# Host-side configuration for the zero-idle Carnyx CI broker — TEMPLATE.
#
# This file is the versioned, secret-free copy of the label contract. The live
# file is /home/carnyx/ISOs/images/ci-broker.env (mode 0600, not in git); keep
# the two in sync by hand, and never commit the live file.
#
# Why the label contract lives here and not in a workflow: the broker claims a
# job only if one of the job's labels is a member of LSBX_QUEUE_LABEL
# (crates/lsbx-broker/src/labels.rs::is_eligible). Workflows select runners by
# LABEL, never by runner group. Getting either wrong is silent — see
# docs/specs/2026-11-20T0202Z_ci-broker-l0-truth-and-observability/SPEC.md.

GITHUB_OWNER=lufs-audio
GITHUB_REPO=lufs-sandbox-server

# Repos polled when App-installation discovery is not in use. Omit this
# entirely to let the broker discover repos from the App installation.
LSBX_CI_REPOS=lufs-audio/kb,lufs-audio/lrex,lufs-audio/lsbx,lufs-audio/resume,lufs-audio/lufs-sandbox-server,lufs-audio/albumdujour,lufs-audio/podcast-pipeline,lufs-audio/syndication,lufs-audio/lufs-runner,lufs-audio/molimo-proxy,lufs-audio/photo-process-registry,lufs-audio/blog-daniel-ramirez-io,lufs-audio/genese-dodecaphonique-assets,lufs-audio/blog-pipeline

# Comma-split. A queued job is eligible only if it carries one of these.
# `lsbx-default` also serves as the fallback label (poll.rs::FALLBACK_QUEUE_LABEL),
# so keep it present; dropping it makes the fallback path unreachable.
# `lsbx-windows` is RETIRED — nothing requests it and nothing offers it.
LSBX_QUEUE_LABEL=lsbx-default,lufs

# Labels Carnyx-provisioned runners advertise. `lsbx-carnyx` is the explicit
# x86 discriminator: `lufs` is also carried by the ARM64 fleet, so a job that
# must land on Carnyx says `lsbx-carnyx`.
RUNNER_LABELS=lsbx-default,lsbx-carnyx,lufs

# Runner group. Stays `continuo` until the scale-set work creates the
# `lsbx-carnyx` group; pointing this at a group that does not exist breaks
# runner registration outright, which is worse than the bug it would fix.
RUNNER_GROUP=continuo

LUFSS_VM_PREFIX=lsbx-carnyx-
NAME_PREFIX=lsbx-carnyx-
RUNNER_ENV_FILE=/home/carnyx/ISOs/images/ci-runner.env
LSBX_BACKEND=libvirt
LIBVIRT_DEFAULT_URI=qemu:///system
LSBX_IMAGES=/home/carnyx/repos/lsbx/images.carnyx.json
LSBX_STATE_DIR=/home/carnyx/ISOs/images/state
LUFSS_LIBVIRT_GOLDEN_DIR=/home/carnyx/ISOs/images/goldens
LUFSS_LIBVIRT_WORK_DIR=/home/carnyx/ISOs/images/work
LSBX_BIN=/home/carnyx/repos/lsbx/target/release/lsbx
LSBX_CI_LEASE=3600
LSBX_CI_POLL_INTERVAL=45
LSBX_CI_FALLBACK_DELAY=0
LSBX_CI_JOB_TIMEOUT=3600
LSBX_CI_RUNNER_WAIT=240
LSBX_READY_TIMEOUT=180
RUNNER_USER=exedev
RUNNER_DIR=/opt/actions-runner

# GH_TOKEN deliberately omitted — the live file supplies it. Never commit it.
