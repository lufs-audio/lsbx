# ~/ISOs/images/scaleset-linux.env on carnyx (mode 0600). Not secret by itself:
# the App key stays in the PEM file it points at and never enters a guest.
LSBX_SS_URL=https://github.com/lufs-audio
LSBX_SS_NAME=lsbx-linux
# Scale sets match ONLY the labels they were created with: list self-hosted/Linux/X64
# explicitly. Add `lufs` once lufs-audio/lufs-runner pins its Pi selftest to ARM64.
LSBX_SS_LABELS=lsbx-linux,lsbx-default,lsbx-carnyx,self-hosted,Linux,X64
LSBX_SS_RUNNER_GROUP=continuo
LSBX_SS_MIN_RUNNERS=0
LSBX_SS_MAX_RUNNERS=4

GITHUB_APP_ID=4377007
GITHUB_APP_KEY=/home/carnyx/ISOs/images/app-private-key.pem
# GITHUB_APP_INSTALLATION_ID=   # optional; looked up from the org when unset

LSBX_SS_LSBX_BIN=/home/carnyx/repos/lsbx/target/release/lsbx
LSBX_SS_LSBX_ARGS="--backend libvirt --images /home/carnyx/repos/lsbx/images.carnyx.json --state-dir /home/carnyx/ISOs/images/state"
LSBX_LIBVIRT_IMAGES_DIR=/home/carnyx/ISOs/images/goldens
LSBX_LIBVIRT_VM_DIR=/home/carnyx/ISOs/images/work
LSBX_SS_PROFILE=ci
LSBX_SS_LEASE=3h
LSBX_SS_BOOT_TIMEOUT=10m
LSBX_SS_IDLE_TIMEOUT=3m
LSBX_SS_RUNNER_USER=exedev
LSBX_SS_RUNNER_TARBALL=/home/carnyx/ISOs/images/cache/actions-runner-linux-x64-2.338.2.tar.gz
LSBX_SS_GUEST_SCRIPT=/home/carnyx/repos/lsbx/scripts/run-jit-runner.sh
LSBX_SS_STATE=/home/carnyx/ISOs/images/state/scaleset-linux.json
# Sweep libvirt domains with this prefix that lsbx never recorded (killed mid-`lsbx up`).
LSBX_SS_VIRSH_URI=qemu:///system
